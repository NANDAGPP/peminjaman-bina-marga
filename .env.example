# Salin menjadi .env (atau set di panel hosting) lalu sesuaikan nilainya.

# --- Database ---
# Pilih salah satu: DATABASE_URL, atau DB_* di bawahnya.
# DATABASE_URL=postgres://user:password@host:5432/binamarga
DB_DRIVER=pgsql
DB_HOST=127.0.0.1
DB_PORT=5432
DB_NAME=binamarga
DB_USER=postgres
DB_PASSWORD=

# --- API ---
# Origin frontend yang boleh memanggil API, dipisah koma.
ALLOWED_ORIGINS=http://localhost:5173

# Lax untuk frontend dan backend di domain yang sama.
# None bila frontend di domain lain (mis. Vercel); wajib HTTPS.
SESSION_SAMESITE=Lax

# Set 1 hanya bila server berada di belakang reverse proxy / load balancer
# yang mengisi header X-Forwarded-For. Di Vercel otomatis aktif.
TRUSTED_PROXY=0

# files (default lokal) atau database. Di Vercel otomatis memakai database,
# karena file sesi tidak bertahan antar-request di lingkungan serverless.
SESSION_DRIVER=files

APP_TIMEZONE=Asia/Jakarta

# Set 1 hanya di mesin pengembangan untuk menampilkan detail error koneksi.
APP_DEBUG=0
